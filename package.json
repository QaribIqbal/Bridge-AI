{
  "name": "bridge",
  "productName": "Bridge",
  "version": "0.1.1",
  "private": true,
  "description": "Visible always-on-top meeting assistant",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify:gemini": "npm run build && node scripts/verify-gemini.mjs",
    "dist:mac": "npm run build && electron-builder --mac zip"
  },
  "build": {
    "appId": "com.qarib.bridge",
    "productName": "Bridge",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
