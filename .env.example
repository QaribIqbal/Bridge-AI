# Copy this file to .env and fill in your own key.
# .env is gitignored. Never commit a real key.
GEMINI_API_KEY=your-gemini-api-key

# Optional. Bridge defaults to a current Gemini flash model that accepts
# text, audio, and images on the free tier.
# GEMINI_MODEL=gemini-2.5-flash

# Optional accelerator overrides. See README for the format.
# BRIDGE_SUGGEST_SHORTCUT=Ctrl+Shift+Space
# BRIDGE_CAPTURE_SHORTCUT=Ctrl+Shift+C
