# Copy this file to .env and fill in your own keys.
# .env is gitignored. Never commit a real key.

# Primary: fast speech-to-text (short complete webm chunks → OpenAI audio/transcriptions).
OPENAI_API_KEY=your-openai-api-key

# Optional. Defaults to gpt-4o-mini-transcribe. whisper-1 also works.
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Suggest reply + Read screen (text / vision). Also used as a slow STT fallback
# when OPENAI_API_KEY is missing — the UI warns that path is not live.
GEMINI_API_KEY=your-gemini-api-key

# Optional. Bridge defaults to a current Gemini flash-lite model for text and images.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional accelerator overrides. See README for the format.
# BRIDGE_SUGGEST_SHORTCUT=Ctrl+Shift+Space
# BRIDGE_CAPTURE_SHORTCUT=Ctrl+Shift+C
